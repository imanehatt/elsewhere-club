# Copy this file to `.env.local` and fill in the values. NEVER commit .env.local.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only master key — needed for the booking system (traveler links). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: emails (https://resend.com) ---
# Alerts to you for new requests, and booking emails to travelers (live mode only).
# Leave blank to skip emails — everything is still saved in the admin dashboard.
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
NOTIFICATION_FROM_EMAIL=
